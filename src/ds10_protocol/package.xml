<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ds10_protocol</name>
  <version>0.1.0</version>
  <description>
    Application-layer protocol implementation for DS10 driver. Defines data field
    layout (function codes, flags, sequence numbers) and provides codec functions
    and a bridge node for transparent Frame forwarding with protocol-level features
    (ACK auto-reply, sequence tracking, error detection).
  </description>

  <maintainer email="2322958796@qq.com">wangxu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ds10_interfaces</depend>

  <test_depend>nlohmann-json-dev</test_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
